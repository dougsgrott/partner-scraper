# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Raw fetch archive (large; re-fetchable but slow — keep it, never commit it)
raw/

# Local corpus + index (rebuildable; not committed)
data/*
!data/.gitkeep
state/*
!state/.gitkeep

# Secrets
.env

# Tool caches
.ruff_cache/
