# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Raw fetch archive (large; re-fetchable but slow — keep it, never commit it)
raw/

# Local corpus + index (rebuildable; not committed)
data/*
!data/.gitkeep
state/*
!state/.gitkeep

# Generated change-feed output. The full feed report (~700 KB) and its JSON (~2.5 MB) are
# regenerable bulk; the digest is small, is the actual product, and is worth diffing week
# to week — so it is tracked.
# reports/*
# !reports/changefeed/
# reports/changefeed/*
# !reports/changefeed/digest-*.md
.claude/
CLAUDE.md

# Secrets
.env

# Tool caches
.ruff_cache/
